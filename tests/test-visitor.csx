using System;
using System.IO;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
using UnityEngine;
using VirtualMuseum;
using CampusMuseum;
var checks=new List<string>();void Check(bool ok,string message){if(!ok)throw new Exception(message);checks.Add(message);}
var app=UnityEngine.Object.FindFirstObjectByType<MuseumApp>();var player=UnityEngine.Object.FindFirstObjectByType<MuseumPlayer>();
var flags=BindingFlags.NonPublic|BindingFlags.Instance;
void Call(string name,params object[] args)=>typeof(MuseumApp).GetMethod(name,flags).Invoke(app,args);
T Field<T>(string name)=>(T)typeof(MuseumApp).GetField(name,flags).GetValue(app);
void Set(string name,object value)=>typeof(MuseumApp).GetField(name,flags).SetValue(app,value);
var api=app.Model;api.Replace(new Museum(),new VisitorSession());
var a=api.CreateRoom("Entrée",new Vector3(-9,0,0),8,8,3);var b=api.CreateRoom("Galerie",Vector3.zero,8,8,3);var c=api.CreateRoom("Dernière salle",new Vector3(9,0,0),8,8,3);
api.ConnectRooms(a.id,b.id);api.ConnectRooms(b.id,c.id);
var definition=api.Catalog.Definitions[0].id;
var first=api.AddArtwork(definition,a.id,new Vector3(0,1,0));var middle=api.AddArtwork(definition,b.id,new Vector3(0,1,0));var last=api.AddArtwork(definition,c.id,new Vector3(1,1,0));var alternative=api.AddArtwork(definition,b.id,new Vector3(2,1,1));
var tour1=api.CreateTour("Parcours des trois salles","Découvrir les œuvres dans l’ordre.");foreach(var id in new[]{first.id,middle.id,last.id})api.AddTourArtwork(tour1.id,id);
var tour2=api.CreateTour("Autre regard","Revenir à l’entrée après la galerie.");foreach(var id in new[]{alternative.id,first.id})api.AddTourArtwork(tour2.id,id);
Set("selectedRoom",a.id);Call("Draw");Call("EnterMuseum");Call("Draw");
Check(UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Any(x=>x.name=="Parcours 1"),"Parcours 1 sélectionnable au sol");
Check(UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Any(x=>x.name=="Parcours 2"),"Parcours 2 sélectionnable au sol");
Check(!GameObject.Find("Panneau de la galerie"),"Ancien tableau de visite retiré");
Call("StartTour",tour1.id);Call("Draw");
int traces=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Count(x=>x.name=="Parcours 1");
player.Place(a.position+new Vector3(.95f,0,0),0);Call("UpdateVisitorInteraction");Call("Draw");
Check(api.Session.index==1,"Validation automatique dans la zone");
Check(GameObject.Find("Œuvre visitée")!=null,"Coche verte visible sur le cartel");
Check(UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Count(x=>x.name=="Parcours 1")==traces,"Traces conservées après visite");
Call("MoveToRoom",api.GetRoom(b.id),a.id);Call("Draw");
Check(UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Count(x=>x.name=="Passage")==3,"Toutes les portes conservées dont le retour");
Call("StartTour",tour2.id);player.Place(b.position+alternative.localPosition+new Vector3(0,0,-.95f),0);Call("UpdateVisitorInteraction");Call("Draw");
Check(Field<Dictionary<string,HashSet<string>>>("visitHistory")[tour2.id].Contains(alternative.id),"Progression du second parcours indépendante");
Call("StartTour",tour1.id);Check(api.Session.index==1,"Changement de parcours conserve le premier progrès");
Call("StartTour",tour2.id);Check(api.Session.index==1,"Retour au second parcours conserve son progrès");Call("StartTour",tour1.id);
player.Place(b.position+new Vector3(-.95f,0,0),0);Call("UpdateVisitorInteraction");Call("Draw");Check(api.Session.index==2,"Deuxième étape atteinte");
var passage=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name=="Passage"&&x.transform.parent.name==c.name);
player.Place(passage.transform.parent.TransformPoint(new Vector3(0,0,-.3f)),0);Set("doorCooldown",0f);Call("UpdateVisitorInteraction");Call("Draw");
Check(Field<string>("visitorRoom")==c.id,"Passage de porte au contact");
Call("UpdateVisitorInteraction");Check(Field<string>("visitorRoom")==c.id,"Pas de rebond automatique à la porte d’arrivée");
player.Place(c.position+new Vector3(1,0,-.95f),0);Call("UpdateVisitorInteraction");Call("Draw");Check(api.IsComplete,"Parcours terminé automatiquement");
Check(UnityEngine.Object.FindObjectsByType<TextMesh>(FindObjectsSortMode.None).Any(x=>x.text.Contains("PARCOURS TERMINÉ")),"Fin de parcours explicitement affichée");
var history=Field<Dictionary<string,HashSet<string>>>("visitHistory");
var path=Path.Combine(Application.persistentDataPath,"campus-visited-artworks.json");bool existed=File.Exists(path);var backup=existed?File.ReadAllBytes(path):null;
try{Call("SaveVisitHistory");history.Clear();Call("LoadVisitHistory");Check(history[tour1.id].Count==3&&history[tour2.id].Contains(alternative.id),"Historique multi-parcours sauvegardé et rechargé");}
finally{if(existed)File.WriteAllBytes(path,backup);else if(File.Exists(path))File.Delete(path);}
var snapshot=MuseumPersistence.ToJson(api);Call("BackToWorkshop");Call("Draw");
Set("selectedArt",first.id);Call("RemoveArtwork");Set("selectedRoom",c.id);Set("confirmDelete",true);Call("DeleteRoom");Call("Draw");
Check(api.GetArtwork(first.id)==null&&api.GetRoom(c.id)==null,"Retrait œuvre et suppression salle");
Check(api.GetTour(tour1.id).artworkIds.Count==1&&api.GetTour(tour2.id).artworkIds.Count==1,"Parcours actualisés après suppressions");
Call("EnterMuseum");Call("Draw");Call("StartTour",tour1.id);Call("Draw");Check(api.Validate().Count==0,"Nouvelle visite cohérente après suppressions");
Call("BackToWorkshop");Check(MuseumPersistence.TryLoadJson(api,snapshot,out var error),"Rechargement de la configuration complète");Call("Draw");
Check(api.Data.rooms.Count==3&&api.Data.artworks.Count==4,"Salles et œuvres restaurées");
Set("selectedArt",first.id);Set("boardSection",Enum.ToObject(typeof(MuseumApp).GetNestedType("BoardSection",BindingFlags.NonPublic),1));Call("Draw");
var action=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).First(x=>x.name==first.title&&x.transform.parent.name=="Tableau de l’atelier");action.Press(new MuseumPlayer.Hand());Call("Draw");
Check(GameObject.Find("Œuvre repérée")!=null,"Œuvre sélectionnée au tableau repérée sur maquette");
Check(api.Validate().Count==0,"Modèle final valide");
return string.Join("\n",checks);

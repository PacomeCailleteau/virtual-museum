using System;
using System.Linq;
using System.Reflection;
using UnityEngine;
using VirtualMuseum;
using CampusMuseum;
var app=UnityEngine.Object.FindFirstObjectByType<MuseumApp>();var f=BindingFlags.Instance|BindingFlags.NonPublic;var api=app.Model;
void Call(string n,params object[] args)=>typeof(MuseumApp).GetMethod(n,f).Invoke(app,args);
void Set(string n,object value)=>typeof(MuseumApp).GetField(n,f).SetValue(app,value);
void Check(bool ok,string name){if(!ok)throw new Exception(name);}
Call("ResetWorkshop",true);
var room=api.CreateRoom("Salle test",Vector3.zero,8,8,4);
var one=api.AddArtwork(api.Catalog.Definitions[0].id,room.id,new Vector3(-1,1,0));var two=api.AddArtwork(api.Catalog.Definitions[1].id,room.id,new Vector3(1,1,0));
var tour=api.CreateTour("Ordre des étiquettes");api.AddTourArtwork(tour.id,one.id);api.AddTourArtwork(tour.id,two.id);api.StartTour(tour.id);api.Advance();Set("selectedTour",tour.id);Call("Draw");
var hand=new MuseumPlayer.Hand();typeof(MuseumPlayer.Hand).GetField("NearSelection",f).SetValue(hand,true);
WorldAction Step()=>UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(a=>a.name=="Étiquette œuvre "+two.id+" 1");
var step=Step();hand.Ray=new Ray(step.transform.position,Vector3.forward);step.Press(hand);step.Release(hand);Call("Draw");
Check(api.Session.index==1,"Une simple sélection d’étape ne remet pas la progression à zéro.");
step=Step();hand.Ray=new Ray(step.transform.position,Vector3.forward);step.Press(hand);
var layout=UnityEngine.Object.FindFirstObjectByType<WorkshopLayout>();hand.Ray=new Ray(layout.board.TransformPoint(new Vector3(1.2f,.04f,-.06f)),Vector3.forward);step.Release(hand);Call("Draw");
Check(api.GetTour(tour.id).artworkIds.SequenceEqual(new[]{two.id,one.id}),"Le déplacement d’étiquette réordonne les étapes.");
Set("selectedArt",one.id);Call("AddStop");Call("Draw");
Check(api.GetTour(tour.id).artworkIds.Count==3,"Le raccourci depuis une fiche ajoute aussi une étape.");
Check((string)typeof(MuseumApp).GetField("boardNotice",f).GetValue(app)!=null,"Le raccourci affiche la confirmation.");
var left=new MuseumPlayer.Hand();var right=new MuseumPlayer.Hand();left.AdjustReach(1,3);
Check(Mathf.Abs(left.Reach-1.8f)<.001f&&right.Reach==.035f,"Les portées gauche et droite sont indépendantes et bornées.");
left.AdjustReach(-1,3);Check(left.Reach==.035f,"La portée minimale reste proche de la main.");
Check(api.Validate().Count==0,"Le modèle reste valide après réordonnancement.");
return "PASS 7 : sélection sans réinitialisation, ordre des étiquettes, raccourci, confirmation, indépendance des portées, bornes, cohérence.";

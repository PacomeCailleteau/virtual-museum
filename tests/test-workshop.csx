using System;
using System.Linq;
using System.Collections.Generic;
using System.Reflection;
using UnityEngine;
using VirtualMuseum;
using CampusMuseum;
var app=UnityEngine.Object.FindFirstObjectByType<MuseumApp>();var player=UnityEngine.Object.FindFirstObjectByType<MuseumPlayer>();var layout=UnityEngine.Object.FindFirstObjectByType<WorkshopLayout>();
var f=BindingFlags.NonPublic|BindingFlags.Instance;
var checks=new List<string>();void Check(bool ok,string name){if(!ok)throw new Exception(name);checks.Add(name);}
void Call(string name,params object[] args)=>typeof(MuseumApp).GetMethod(name,f).Invoke(app,args);
T Field<T>(string name)=>(T)typeof(MuseumApp).GetField(name,f).GetValue(app);
void Set(string name,object value)=>typeof(MuseumApp).GetField(name,f).SetValue(app,value);
WorldAction Button(string name)=>UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).First(x=>x.name==name);
var api=app.Model;
Check(api.Data.rooms.Count==3&&api.Data.artworks.Count==6&&api.Data.tours.Count==2,"Démarrage avec musée initial complet");
Check(!layout.startWithEmptyMuseum,"Exemple activé par défaut");
Check(Vector3.Distance(layout.board.position,layout.terminal.position)<3.1f&&Quaternion.Angle(layout.board.rotation,layout.terminal.rotation)<1,"Terminal à côté du tableau blanc");
Check(layout.board.Find("Écran").GetComponent<Renderer>().sharedMaterial.color.r>.9f,"Surface du tableau blanche");
var empty=layout.emptyBuzzer.GetComponentInChildren<PunchBuzzer>();var reset=layout.resetBuzzer.GetComponentInChildren<PunchBuzzer>();
bool Strike(PunchBuzzer buzzer){var bounds=buzzer.GetComponent<Collider>().bounds;var p=bounds.center;p.y=bounds.max.y+.045f;return buzzer.ObserveStroke(p+Vector3.up*.08f,p-Vector3.up*.04f,.05f);}
var contact=empty.GetComponent<Collider>().bounds.center+Vector3.up*.15f;
Check(!empty.ObserveStroke(contact,contact,.05f),"Un poing immobile ne déclenche pas le buzzer");
Check(!empty.ObserveStroke(contact-Vector3.up*.1f,contact,.05f),"Un mouvement montant ne déclenche pas le buzzer");
Check(Strike(empty)&&api.Data.rooms.Count==0,"Buzzer orange vide la maquette");
Check(!Strike(empty),"Buzzer protégé contre le double déclenchement");
Check(GameObject.Find("Étincelles de confirmation")!=null,"Étincelles après frappe");
Check(Strike(reset)&&api.Data.rooms.Count==3&&api.Data.artworks.Count==6&&api.Data.tours.Count==2,"Buzzer vert restaure salles œuvres et parcours");
Call("ResetWorkshop",true);Call("Draw");
var originalMaterial=layout.mapSurface.GetComponent<Renderer>().sharedMaterial;
var surface=layout.mapSurface.GetComponent<WorldAction>();Check(!surface.IsAvailable,"Table inerte hors mode tracé");
var hand=player.Right;typeof(MuseumPlayer).GetField("xr",f).SetValue(player,true);
var pointer=typeof(MuseumPlayer).GetMethod("SetPointer",f);
void Input(bool pressed,bool valid=true){Physics.SyncTransforms();pointer.Invoke(player,new object[]{hand,valid,pressed,false});}
hand.Ray=new Ray(layout.mapOrigin.position+Vector3.up*.6f,Vector3.down);Input(false);Input(true);Input(false);
Check(hand.Held==null&&layout.mapSurface.GetComponent<Renderer>().sharedMaterial==originalMaterial,"Survol et clic ne recolorent pas la table");
Set("drawing",true);Call("Draw");
var first=layout.mapOrigin.position+new Vector3(-.40f,.6f,-.25f);var last=layout.mapOrigin.position+new Vector3(.0f,.6f,.10f);
hand.Ray=new Ray(first,Vector3.down);Input(true);Check(api.Data.rooms.Count==0&&Field<MuseumPlayer.Hand>("traceHand")==hand,"Début du tracé au maintien");
hand.Ray=new Ray(last,Vector3.down);Call("UpdateRoomTrace");Check(api.Data.rooms.Count==0,"Maintien prévisualise sans créer");Input(false);Call("Draw");
Check(api.Data.rooms.Count==1,"Salle créée au relâchement sans second clic");
Set("drawing",true);Call("Draw");hand.Ray=new Ray(first,Vector3.down);Input(true);hand.Ray=new Ray(last,Vector3.down);Input(false);Call("Draw");
Check(api.Data.rooms.Count==1,"Tracé chevauchant refusé");Set("drawing",false);
api.Replace(new Museum(),new VisitorSession());
var a=api.CreateRoom("Salle A",Vector3.zero,6,8,4);var b=api.CreateRoom("Salle B",new Vector3(16,0,0),6,6,3);
Set("selectedRoom",a.id);Call("Draw");
var root=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name==a.name&&x.transform.parent.name=="Atelier").transform;
Check(Mathf.Approximately(root.Find("Mur fond").localScale.y,root.Find("Mur gauche").localScale.y),"Quatre cloisons miniatures de hauteur uniforme");
var fake=new MuseumPlayer.Hand();typeof(MuseumPlayer.Hand).GetField("NearSelection",f).SetValue(fake,true);
var heightArrow=UnityEngine.Object.FindObjectsByType<StretchArrow>(FindObjectsSortMode.None).Single(x=>x.name=="Flèche Hauteur");var heightAction=heightArrow.GetComponentInChildren<WorldAction>();
fake.Ray=new Ray(heightAction.transform.position,Vector3.down);heightAction.Press(fake);
fake.Ray=new Ray(fake.Ray.origin+Vector3.down*.015f,Vector3.down);Call("UpdateRoomResize");
Check(!root.Find("Mur fond").GetComponent<Renderer>().enabled,"Ancien mesh masquant la réduction caché pendant le réglage");
var resized=Field<Transform>("resizePreview");Check(resized.Find("Mur fond").localScale.y<4*.24f,"Mesh réduit pendant la prévisualisation");heightAction.Release(fake);Call("Draw");
Check(api.GetRoom(a.id).height<4,"Réduction de hauteur enregistrée");
root=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name==a.name&&x.transform.parent.name=="Atelier").transform;
Check(!UnityEngine.Object.FindObjectsByType<TextMesh>(FindObjectsSortMode.None).Any(x=>x.text=="Rotation · 90°"),"Panneau gênant retiré de la poignée");
var arc=UnityEngine.Object.FindObjectsByType<StretchArrow>(FindObjectsSortMode.None).Single(x=>x.name=="Arc de rotation");arc.GetComponentInChildren<WorldAction>().Hover(true);
Check(Field<TextMesh>("rotationHelp").text.Contains("maintenir Grab"),"Aide rotation sur la console");
Check(Mathf.Abs(Field<TextMesh>("rotationHelp").transform.localPosition.z+.031f)<.001f,"Texte collé à la console");
fake.Ray=new Ray(root.position+Vector3.right*.3f,Vector3.down);Call("BeginRoomRotation",api.GetRoom(a.id),root,fake);
fake.Ray=new Ray(root.position+Vector3.back*.3f,Vector3.down);Call("UpdateRoomRotation");
Check(Quaternion.Angle(Field<Transform>("rotationRig").rotation,Quaternion.Euler(0,90,0))<.1f,"Poignée tourne avec la salle en prévisualisation");Call("EndRoomRotation",fake);Call("Draw");
Check(Mathf.Abs(Mathf.DeltaAngle(api.GetRoom(a.id).rotation.eulerAngles.y,90))<.1f,"Rotation appliquée à 90 degrés");
root=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name==a.name&&x.transform.parent.name=="Atelier").transform;
fake.Ray=new Ray(root.position+Vector3.up*.2f,Vector3.forward);Call("BeginRoomDrag",api.GetRoom(a.id),fake,root);
var near=fake.CarryPoint;fake.AdjustReach(1,.5f);for(int i=0;i<40;i++)Call("UpdateRoomDrag",1f/60f);
Check(Vector3.Distance(Field<Transform>("carriedView").position,fake.Ray.origin)>.4f,"Portée de la salle augmentée avec le stick");
fake.AdjustReach(-1,.5f);Call("UpdateRoomDrag",1f/60f);Check(Vector3.Distance(Field<Transform>("carriedView").position,fake.Ray.origin)<.08f,"Salle rapprochée avec le stick");
typeof(MuseumPlayer.Hand).GetField("ReleaseCancelled",f).SetValue(fake,true);Call("DropRoom",fake);typeof(MuseumPlayer.Hand).GetField("ReleaseCancelled",f).SetValue(fake,false);Call("Draw");
Set("draft",new MuseumEdit(api,a.id));Call("Draw");var draft=Field<MuseumEdit>("draft");
var definition=api.Catalog.Definitions[0];Button(definition.title).Press(fake);Call("Draw");
var sample=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name==definition.title&&x.Release!=null&&x.transform.parent.name=="Catalogue à tiroirs");
fake.Ray=new Ray(sample.transform.position,Vector3.forward);sample.Press(fake);fake.AdjustReach(1,.4f);Call("UpdateArtworkDrag",1f/60f);
Check(Vector3.Distance(Field<GameObject>("heldArtwork").transform.position,fake.Ray.origin)>.3f,"Portée de l’œuvre augmentée avec le stick");
fake.Reach=.035f;fake.Ray=new Ray(layout.editingOrigin.position+new Vector3(.12f,.25f,-.10f),Vector3.forward);for(int i=0;i<60;i++)Call("UpdateArtworkDrag",1f/60f);
Check(Field<bool>("artworkCanDrop"),"Dépôt œuvre valide après réglage de portée");sample.Release(fake);Call("Draw");
var art=draft.Api.GetArtworksInRoom(a.id).Single();var lever=Button("Poignée du levier");var pivot=lever.transform.parent;
fake.Ray=new Ray(lever.transform.position,Vector3.forward);lever.Press(fake);float high=lever.transform.position.y;
fake.Ray=new Ray(pivot.TransformPoint(Quaternion.Euler(-55,0,0)*Vector3.up*.35f),Vector3.forward);Call("UpdateValidationLever");
Check(!Field<bool>("leverReady"),"Course du levier prolongée avant validation");
fake.Ray=new Ray(pivot.TransformPoint(Quaternion.Euler(-90,0,0)*Vector3.up*.35f),Vector3.forward);Call("UpdateValidationLever");
Check(Field<bool>("leverReady")&&high-lever.transform.position.y>.30f,"Grand geste descendant de plus de 30 cm");lever.Release(fake);Call("Draw");
var small=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name==a.name&&x.Release!=null&&x.transform.parent.name=="Atelier");
fake.Ray=new Ray(small.transform.position,Vector3.forward);small.Press(fake);
fake.Ray=new Ray(layout.mapOrigin.position+new Vector3(.12f,.3f,0),Vector3.forward);for(int i=0;i<90;i++)Call("UpdateRoomDrag",1f/60f);
Check(Field<Renderer>("returnMarker").sharedMaterial.color==WorldView.Teal,"Socle recoloré quand le retour est valide");
Check(Vector3.Distance(Field<Transform>("carriedView").position,layout.mapOrigin.position+Vector3.up*.06f)<.015f,"Salle aimantée à son emplacement initial");small.Release(fake);Call("Draw");
Check(Field<string>("returningRoom")==null&&api.GetRoom(a.id).position==Vector3.zero,"Retour exact au relâchement");
var artView=Field<Dictionary<string,GameObject>>("artworkViews")[art.id];Check(!artView.GetComponent<WorldAction>()&&artView.GetComponentsInChildren<Collider>().All(x=>!x.enabled),"Œuvres de la maquette non cliquables");
Call("CreateTour");var firstTour=Field<string>("selectedTour");Set("boardSection",Enum.ToObject(typeof(MuseumApp).GetNestedType("BoardSection",BindingFlags.NonPublic),0));Call("Draw");
WorldAction Stock()=>UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name.Contains(art.id)&&x.name.EndsWith("stock"));
void AddTag(){var stock=Stock();fake.Ray=new Ray(stock.transform.position,Vector3.forward);stock.Press(fake);fake.Ray=new Ray(layout.board.TransformPoint(new Vector3(1.2f,.04f,-.06f)),Vector3.forward);Call("UpdateMagneticTag");stock.Release(fake);Call("Draw");}
AddTag();Check(api.GetTour(firstTour).artworkIds.SequenceEqual(new[]{art.id}),"Étiquette déposée ajoute l’œuvre au parcours");
Check(Field<string>("boardNotice").Contains(art.title)&&Field<string>("boardNotice").Contains("étape 1"),"Confirmation d’ajout visible sur le tableau");Check(Stock()!=null,"Stock d’étiquettes conservé après ajout");
Call("CreateTour");var secondTour=Field<string>("selectedTour");Call("Draw");AddTag();Check(api.GetTour(firstTour).artworkIds.Count==1&&api.GetTour(secondTour).artworkIds.Count==1,"Même œuvre disponible dans plusieurs parcours");
var outside=Stock();fake.Ray=new Ray(outside.transform.position,Vector3.forward);outside.Press(fake);fake.Ray=new Ray(layout.board.TransformPoint(new Vector3(-1.5f,-1.1f,-.06f)),Vector3.forward);outside.Release(fake);Call("Draw");Check(api.GetTour(secondTour).artworkIds.Count==1,"Dépôt hors parcours annulé");
Call("EnterMuseum");Call("Draw");Check(Field<bool>("guided")&&api.HasSelectedTour,"Parcours actif dès l’entrée sans clic au sol");Call("BackToWorkshop");Call("Draw");
Check(api.Validate().Count==0,"Modèle final cohérent");
return "PASS "+checks.Count+"\n"+string.Join("\n",checks);

using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
using UnityEngine;
using VirtualMuseum;
using CampusMuseum;
var checks=new List<string>();
void Check(bool condition,string name){if(!condition)throw new Exception(name);checks.Add(name);}
var app=UnityEngine.Object.FindFirstObjectByType<MuseumApp>();var player=UnityEngine.Object.FindFirstObjectByType<MuseumPlayer>();var layout=UnityEngine.Object.FindFirstObjectByType<WorkshopLayout>();
var flags=BindingFlags.NonPublic|BindingFlags.Instance;
void Call(string name,params object[] args)=>typeof(MuseumApp).GetMethod(name,flags).Invoke(app,args);
T Field<T>(string name)=>(T)typeof(MuseumApp).GetField(name,flags).GetValue(app);
void Set(string name,object value)=>typeof(MuseumApp).GetField(name,flags).SetValue(app,value);
WorldAction Button(string name)=>UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).First(a=>a.name==name);
var hand=new MuseumPlayer.Hand();typeof(MuseumPlayer.Hand).GetField("NearSelection",flags).SetValue(hand,true);
Check(app.Model.Data.rooms.Count==0,"Démarrage sur table vide");
Check(layout.board.position.x< -4.3f,"Tableau fixé au mur gauche");
Check(layout.terminal!=null,"Journal mural référencé");
Set("drawing",true);
Call("Plot",new Ray(layout.mapOrigin.position+new Vector3(-.4f,1,-.2f),Vector3.down));
Call("Plot",new Ray(layout.mapOrigin.position+new Vector3(-.1f,1,.05f),Vector3.down));
Check(app.Model.Data.rooms.Count==1,"Création depuis table vide");
app.Model.Replace(new Museum(),new VisitorSession());
var a=app.Model.CreateRoom("Salle A",Vector3.zero,6,8,3);
var b=app.Model.CreateRoom("Salle B",new Vector3(16,0,0),6,6,3);
var c=app.Model.CreateRoom("Salle C",new Vector3(-16,0,0),6,6,3);
Set("selectedRoom",a.id);Call("Draw");
var rotationHandle=UnityEngine.Object.FindObjectsByType<StretchArrow>(FindObjectsSortMode.None).Single(x=>x.name=="Arc de rotation");
Check(UnityEngine.Object.FindObjectsByType<TextMesh>(FindObjectsSortMode.None).Any(x=>x.text=="Rotation · 90°"),"Poignée de rotation nommée");
rotationHandle.GetComponentInChildren<WorldAction>().Hover(true);
Check(GameObject.Find("Aide poignée de rotation")!=null,"Consigne rotation visible au survol");
rotationHandle.GetComponentInChildren<WorldAction>().Hover(false);
Check(GameObject.Find("Aide poignée de rotation")==null,"Consigne rotation masquée hors survol");
var zArrow=UnityEngine.Object.FindObjectsByType<StretchArrow>(FindObjectsSortMode.None).Single(x=>x.name=="Flèche Longueur");
Check(Vector3.Dot(zArrow.transform.forward,Vector3.forward)<-.99f,"Flèche Z devant la salle");
foreach(int axis in new[]{0,1,2})
{
var arrow=UnityEngine.Object.FindObjectsByType<StretchArrow>(FindObjectsSortMode.None).Single(x=>x.name=="Flèche "+new[]{"Largeur","Longueur","Hauteur"}[axis]);
var action=arrow.GetComponentInChildren<WorldAction>();var origin=arrow.transform.position;var tip=action.transform.position;
hand.Ray=new Ray(tip,Vector3.down);action.Press(hand);
hand.Ray=new Ray(tip+arrow.transform.forward*.025f,Vector3.down);Call("UpdateRoomResize");
Check(arrow.transform.position==origin,"Base fixe axe "+axis);
Check(Vector3.Distance(action.transform.position,tip)>.005f,"Flèche étirée axe "+axis);
action.Release(hand);Call("Draw");
}
var candidate=app.Model.GetRoom(b.id);candidate.position=new Vector3((app.Model.GetRoom(a.id).width+candidate.width)/2+.3f,0,0);
Call("SnapRoom",candidate);
float expected=(app.Model.GetRoom(a.id).width+candidate.width)/2;
Check(Mathf.Abs(candidate.position.x-expected)<.001f,"Aimantation des bords");
app.Model.SetRoomTransform(b.id,candidate.position,Quaternion.identity);Call("ConnectTouchingRooms",b.id);Call("Draw");
Check(app.Model.GetRoom(a.id).connections.Contains(b.id)&&app.Model.GetRoom(b.id).connections.Contains(a.id),"Connexion automatique réciproque");
var root=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name=="Salle A"&&x.transform.parent.name=="Atelier").transform;
hand.Ray=new Ray(root.position+new Vector3(.04f,.15f,0),Vector3.down);Call("BeginRoomRotation",app.Model.GetRoom(a.id),root,hand);
hand.Ray=new Ray(root.position+new Vector3(0,.15f,-.3f),Vector3.down);Call("UpdateRoomRotation");
Check(Field<string>("rotationError")!=null,"Rotation refusée si chevauchement");Call("EndRoomRotation",hand);Call("Draw");
app.Model.SetRoomTransform(b.id,new Vector3(16,0,0),Quaternion.identity);Call("Draw");
root=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name=="Salle A"&&x.transform.parent.name=="Atelier").transform;
hand.Ray=new Ray(root.position+Vector3.right*.3f,Vector3.down);Call("BeginRoomRotation",app.Model.GetRoom(a.id),root,hand);
hand.Ray=new Ray(root.position+Vector3.back*.3f,Vector3.down);Call("UpdateRoomRotation");Call("EndRoomRotation",hand);Call("Draw");
Check(Mathf.Abs(Mathf.DeltaAngle(app.Model.GetRoom(a.id).rotation.eulerAngles.y,90))<.1f,"Rotation par cran de 90 degrés");
var draft=new MuseumEdit(app.Model,a.id);Set("draft",draft);Call("Draw");
var definition=app.Model.Catalog.Definitions[0];Button(definition.title).Press(hand);Call("Draw");
var sample=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name==definition.title&&x.Release!=null&&x.transform.parent.name=="Catalogue à tiroirs");
typeof(MuseumPlayer.Hand).GetField("NearSelection",flags).SetValue(hand,false);
hand.Ray=new Ray(sample.transform.position+Vector3.back*.5f,Vector3.forward);sample.Press(hand);
Check(Vector3.Distance(Field<GameObject>("heldArtwork").transform.position,hand.Ray.origin)<.08f,"Tiroir : objet immédiatement en main même à distance");
hand.Ray=new Ray(layout.editingOrigin.position+new Vector3(.12f,.3f,-.12f),Vector3.forward);
for(int i=0;i<60;i++)Call("UpdateArtworkDrag",1f/60f);
Check(Field<bool>("artworkCanDrop"),"Dépôt œuvre avec rayon horizontal");sample.Release(hand);Call("Draw");
Check(draft.Api.GetArtworksInRoom(a.id).Count==1,"Ajout effectif depuis tiroir");
var lever=Button("Poignée du levier");typeof(MuseumPlayer.Hand).GetField("NearSelection",flags).SetValue(hand,true);
hand.Ray=new Ray(lever.transform.position,Vector3.forward);lever.Press(hand);
Check(Field<MuseumEdit>("draft")!=null,"Simple prise du levier ne valide pas");
var restHeight=lever.transform.position.y;
var start=hand.Ray.origin;
hand.Ray=new Ray(start+Vector3.up*.06f,Vector3.forward);Call("UpdateValidationLever");
Check(!Field<bool>("leverReady"),"Lever vers le haut ne valide pas");
hand.Ray=new Ray(start,Vector3.forward);Call("UpdateValidationLever");lever.Release(hand);
Check(Field<MuseumEdit>("draft")!=null,"Geste incomplet conserve le brouillon");
hand.Ray=new Ray(lever.transform.position,Vector3.forward);lever.Press(hand);start=hand.Ray.origin;
hand.Ray=new Ray(start+Vector3.back*.10f+Vector3.down*.04f,Vector3.forward);Call("UpdateValidationLever");
Check(lever.transform.position.y<restHeight-.015f,"Poignée descend dès le début du geste");
float middleHeight=lever.transform.position.y;
hand.Ray=new Ray(start+Vector3.back*.22f+Vector3.down*.12f,Vector3.forward);Call("UpdateValidationLever");
Check(lever.transform.position.y<middleHeight && Field<bool>("leverReady"),"Descente continue jusqu’au repère doré");
typeof(MuseumPlayer.Hand).GetField("ReleaseCancelled",flags).SetValue(hand,true);lever.Release(hand);
Check(Field<MuseumEdit>("draft")!=null && Mathf.Abs(lever.transform.position.y-restHeight)<.001f,"Interruption du geste rétablit le levier sans valider");
typeof(MuseumPlayer.Hand).GetField("ReleaseCancelled",flags).SetValue(hand,false);
hand.Ray=new Ray(lever.transform.position,Vector3.forward);lever.Press(hand);
hand.Ray=new Ray(hand.Ray.origin+Vector3.back*.22f+Vector3.down*.12f,Vector3.forward);Call("UpdateValidationLever");lever.Release(hand);Call("Draw");
Check(Field<MuseumEdit>("draft")==null&&Field<string>("returningRoom")==a.id,"Geste du levier valide la salle");
Check(GameObject.Find("Validation scintillante")!=null,"Scintillements de validation");
var original=app.Model.GetRoom(a.id).position;Button("Replacer sur la maquette").Press(hand);Call("Draw");
Check(app.Model.GetRoom(a.id).position==original,"Retour exact de la salle");
Set("draft",new MuseumEdit(app.Model,a.id));Call("Draw");Call("CloseEdit",false);Call("Draw");
var small=UnityEngine.Object.FindObjectsByType<WorldAction>(FindObjectsSortMode.None).Single(x=>x.name=="Salle A"&&x.Release!=null&&x.transform.parent.name=="Atelier");
hand.Ray=new Ray(small.transform.position+Vector3.up*.15f,Vector3.forward);small.Press(hand);
hand.Ray=new Ray(layout.mapOrigin.position+new Vector3(.2f,.3f,.1f),Vector3.forward);
for(int i=0;i<60;i++)Call("UpdateRoomDrag",1f/60f);
Check(Vector3.Distance(Field<Transform>("carriedView").position,hand.Ray.origin)<.08f,"Salle portée sans éloignement du rayon");
typeof(MuseumPlayer.Hand).GetField("ReleaseCancelled",flags).SetValue(hand,true);small.Release(hand);typeof(MuseumPlayer.Hand).GetField("ReleaseCancelled",flags).SetValue(hand,false);Call("Draw");Button("Replacer sur la maquette").Press(hand);Call("Draw");
Check(app.Model.Validate().Count==0,"Modèle atelier valide");
return string.Join("\n",checks);

